
# ── LLM Configuration ──────────────────────────────────────────────────────────
# Choose one: "ollama" (free, local) | "openai" | "anthropic"
LLM_PROVIDER=ollama

# Ollama (default – fully free and offline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# OpenAI (optional)
OPENAI_API_KEY=

# Anthropic (optional)
ANTHROPIC_API_KEY=

# ── App Config ─────────────────────────────────────────────────────────────────
SECRET_KEY=changeme-use-a-long-random-string-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

DATABASE_URL=sqlite:///./first30.db

CORS_ORIGINS=http://localhost:5173
